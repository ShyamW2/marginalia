{
  "name": "marginalia",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"pnpm --filter @marginalia/server dev\" \"pnpm --filter @marginalia/web dev\"",
    "build": "pnpm --filter @marginalia/shared build && pnpm --filter @marginalia/server build && pnpm --filter @marginalia/web build",
    "start": "pnpm build && NODE_ENV=production pnpm --filter @marginalia/server start",
    "test": "pnpm -r --no-bail test",
    "sync": "node scripts/sync.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
